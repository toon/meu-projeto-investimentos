### 1. Registrar Compra (Abre Ciclo)
@idPortfolio1 = "69f23e6e87311ebcbd674085"
@idPortfolio2 = "69ed108e1f01c653f77e4e75"
POST {{baseUrl}}/transacoes
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
    "idPortfolio": {{idPortfolio1}},
    "idInvestidor": "69efc0237807fdbe21fcdcf1",
    "idAtivoReferencia": {{VALE3}},
    "idCorretora": "69eee7b2c185fc6c0211d54f",
    "idClasseAtivo": "69ed0d598e4480a6b6930faa",
    "dataTransacao": "2025-04-25T10:00:00Z",
    "operacao": "COMPRA",
    "quantidade": 100.00,
    "precoUnitario": 10.00,
    "taxas": 0.00
}

### 2. Registrar Venda Total (Encerra o Ciclo)
POST {{baseUrl}}/transacoes
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
    "idPortfolio": {{idPortfolio1}},
    "idInvestidor": "69efc0237807fdbe21fcdcf1",
    "idAtivoReferencia": {{PETR4}},
    "idCorretora": "69eee7b2c185fc6c0211d54f",
    "idClasseAtivo": "69ed0d598e4480a6b6930faa",
    "dataTransacao": "2025-04-28T15:00:00Z",
    "operacao": "VENDA",
    "quantidade": 100.00,
    "precoUnitario": 16.00,
    "taxas": 0.00
}

### Consolidado por portfólio
# @name consolidadoPorPortfolio
