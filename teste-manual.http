@baseUrl = http://localhost:3005/api
### Admin
# @email = igor@exemplo.com
### Usuário
# @email = igor@exemplo2.com
### Admin
@email = igor@exemplo4.com
@senha = senha_segura

### 1. Registro de Usuário
# @name registro
POST {{baseUrl}}/auth/registrar
Content-Type: application/json

{
  "nome": "Igor",
  "email": "{{email}}",
  "senha": "{{senha}}",
  "papel": "admin"
}

### 2. Login
# @name login
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{email}}",
  "senha": "{{senha}}"
}

### Extração de Variáveis dos Resultados
@authToken = {{login.response.body.token}}
# Se o login retornar o id do usuário ou portfólio, use:
@idPortfolio = {{login.response.body.idPortfolioPadrao}}
@idPortfolio2 = 69f23e6e87311ebcbd674085

### 3. Criar um Ativo (Teste o POST primeiro)
POST {{baseUrl}}/portfolios/{{idPortfolio}}/ativos
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "ticker": "SAUD3",
  "quantidade": 100
}

### 4. Listar meus portfolios
GET {{baseUrl}}/portfolios
Authorization: Bearer {{authToken}}

### Criar porfólio
POST {{baseUrl}}/portfolios
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
    "nome": "Novo portfólio 2",
    "descricao": "Descrição do portfólio 2"
}

### Teste de Erro de Validação (Senha Curta e E-mail Inválido)
POST {{baseUrl}}/auth/registrar
Content-Type: application/json

{
  "nome": "I",
  "email": "email-invalido",
  "senha": "123"
}

###################################################################################################################################
###################################################################################################################################
### Criar uma Transação de Opção (Ticker diferente da Referência)
# @name criarTransacao
POST {{baseUrl}}/portfolios/{{idPortfolio}}/transacoes
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
    "idPortfolio": "{{idPortfolio}}",
    "idAtivoReferencia": "ID_DO_ATIVO_PETR4",
    "tickerOperado": "PETRE281",
    "idCorretora": "ID_DA_XP",
    "idInvestidor": "ID_DO_INVESTIDOR_IGOR",
    "idClasseAtivo": "ID_DA_CLASSE_OPCOES",
    "operacao": "COMPRA",
    "quantidade": 100,
    "precoUnitario": 0.50,
    "dataTransacao": "2026-04-24T10:00:00Z"
}

### 3. Verificar Posição Intermediária (Deve mostrar PM de 35,00)
# @name verificarPosicaoIntermediaria
GET {{baseUrl}}/portfolios/{{idPortfolio}}/posicao
Authorization: Bearer {{authToken}}

### 6. Verificar Posição Final (O PM DEVE SER 10,00)
# @name verificarPosicaoFinal
GET {{baseUrl}}/portfolios/{{idPortfolio}}/posicao
Authorization: Bearer {{authToken}}

### Cadastrar Classe (Necessário ser Admin)
POST {{baseUrl}}/classes-ativos
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "nome": "Ações Brasileiras",
  "slug": "ACAO",
  "descricao": "Ativos de renda variável da B3"
}

