    "operacao": "COMPRA",
    "precoAtivoBase": 26.50,
    "quantidade": 1000,
    "precoUnitario": 0.50
}

### Extrato/Histórico da Posição
# @name extratoPosicao
GET {{baseUrl}}/transacoes?idPortfolio=69f23e6e87311ebcbd674085&idInvestidor=69efc0237807fdbe21fcdcf1&tickerOperado=PETRE281
Authorization: Bearer {{authToken}}

### Criar Estratégia de Opções (Ex: Venda Coberta)
# @name criarEstrategiaVendaCoberta
POST {{baseUrl}}/estrategias-opcoes
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
    "idPortfolio": {{idPortfolio1}},
    "idInvestidor": "69efc0237807fdbe21fcdcf1",
    "nome": "Venda Coberta PETR4 Maio",
    "tipo": "VENDA_COBERTA"
}

### Listar Estratégias Abertas
GET {{baseUrl}}/estrategias-opcoes?status=ABERTA
Authorization: Bearer {{authToken}}

### Listar Estratégias Encerradas
GET {{baseUrl}}/estrategias-opcoes?status=ENCERRADA
Authorization: Bearer {{authToken}}

### Encerrar uma Estratégia Manualmente
# @name encerrarEstrategia
PATCH {{baseUrl}}/estrategias-opcoes/69f7da23fd99447521290eae/encerrar
Authorization: Bearer {{authToken}}
Content-Type: application/json
