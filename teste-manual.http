Authorization: Bearer {{authToken}}

### Consolidado por investidor
# @name consolidadoPorInvestidor
GET {{baseUrl}}/posicoes/investidor/69efc0237807fdbe21fcdcf1/
Authorization: Bearer {{authToken}}

### Consolidado por Ativo
# @name consolidadoPorAtivo
GET {{baseUrl}}/posicoes/ativo/69f04ffce98f8b10459e869a/
Authorization: Bearer {{authToken}}

### Consolidado global
# @name consolidadoGlobal
GET {{baseUrl}}/posicoes
Authorization: Bearer {{authToken}}

### Consolidado global
# @name consolidadoGlobalEncerradas
GET {{baseUrl}}/posicoes?status=ENCERRADA
Authorization: Bearer {{authToken}}

### Transação de dividendo
# @name ADD_DIVIDENDO
POST {{baseUrl}}/transacoes
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "idPortfolio": "69f23e6e87311ebcbd674085",
  "idInvestidor": "69efc0237807fdbe21fcdcf1",
  "idAtivoReferencia": {{PETR4}},
  "idCorretora": "69eee7b2c185fc6c0211d54f",
  "idClasseAtivo": "69ed0d598e4480a6b6930faa",
  "operacao": "DIVIDENDO",
  "quantidade": 200.00,
  "precoUnitario": 1.25,
  "dataCom": "2025-04-25T09:00:00.000Z",
  "dataTransacao": "2025-04-25T09:00:00Z"
}

